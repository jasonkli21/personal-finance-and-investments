# Local development only. Change these values if the database is reachable beyond this machine.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
API_PORT=8000
MAX_IMPORT_FILE_BYTES=5000000
MAX_IMPORT_ROWS=5000

# Used when running the API outside Docker Compose. The API defaults to
# 127.0.0.1 and uses the POSTGRES_* values above.
DATABASE_BACKEND=postgres
DEMO_MODE=false
# Optional explicit connection override. For Compose, use host=db if setting it.
DATABASE_URL=

# Aurora DSQL is opt-in. The official connector obtains short-lived IAM tokens
# from the AWS credential chain; do not put tokens or static passwords here.
# DATABASE_BACKEND=aurora_dsql
# AWS_REGION=us-east-1
# AURORA_DSQL_CLUSTER_ENDPOINT=<cluster-endpoint>
# AURORA_DSQL_DB_USER=<least-privilege-application-role>
# AURORA_DSQL_MIGRATION_DB_USER=<schema-migration-role>
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
