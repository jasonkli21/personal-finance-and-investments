# Local development only. Change these values if the database is reachable beyond this machine.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
API_PORT=8000
APP_ENV=development
APP_PUBLIC_ORIGIN=
FILE_STORAGE_BACKEND=local
PRIVATE_GCS_BUCKET=
GCP_PROJECT=
CLOUD_RUN_JOB=
MAX_PRIVATE_FILE_BYTES=20000000
MAX_IMPORT_FILE_BYTES=5000000
MAX_IMPORT_ROWS=5000
MAX_PDF_PAGES=40
PDF_PARSER_TIMEOUT_SECONDS=8
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=3

# Browser sessions are disabled for a loopback/local development workspace.
# Production requires an OIDC issuer/client registered with the exact callback
# <APP_PUBLIC_ORIGIN>/api/v1/auth/callback (origin includes https://). Inject secrets
# from a secret manager; never commit real values.
AUTH_ENABLED=false
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SESSION_SIGNING_KEY=
AUTH_ALLOWED_SUBJECT=
AUTH_PERSONAL_SCOPE_ID=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false

# Stage 1 boundary only: true is rejected until the service contract and
# authentication/authorization + data-handling gates are implemented.
PERSONAL_AI_ENABLED=false

# Used when running the API outside Docker Compose. The API defaults to
# 127.0.0.1 and uses the POSTGRES_* values above.
DATABASE_BACKEND=postgres
DEMO_MODE=false
# Optional explicit connection override. For Compose, use host=db if setting it.
DATABASE_URL=

# Cloud: inject DATABASE_URL from Secret Manager with sslmode=verify-full and
# sslrootcert=system. Optional direct connection for Alembic; never commit values.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE_SECONDS=3000
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Frozen Stage 1 report freshness and deterministic exact-label priority.
QUOTE_STALE_DAYS=7
MANUAL_FUND_STALE_DAYS=30
ISSUER_FUND_STALE_DAYS=7
QUOTE_SOURCE_PRIORITY=manual,cached
FUND_SOURCE_PRIORITY=
# PRIVATE_FILE_DIR=.private/files
