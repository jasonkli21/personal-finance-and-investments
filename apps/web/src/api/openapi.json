{
  "components": {
    "schemas": {
      "AccountCreate": {
        "properties": {
          "account_type": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Account Type",
            "type": "string"
          },
          "base_currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Base Currency",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "account_type",
          "base_currency"
        ],
        "title": "AccountCreate",
        "type": "object"
      },
      "AccountPatch": {
        "properties": {
          "account_type": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Type"
          },
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "base_currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Currency"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "AccountPatch",
        "type": "object"
      },
      "AccountRead": {
        "properties": {
          "account_type": {
            "title": "Account Type",
            "type": "string"
          },
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "base_currency": {
            "title": "Base Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "account_type",
          "base_currency",
          "active"
        ],
        "title": "AccountRead",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PositionInput": {
        "properties": {
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "quantity": {
            "maxLength": 40,
            "pattern": "^-?\\d+(?:\\.\\d{1,10})?$",
            "title": "Quantity",
            "type": "string"
          },
          "reported_price": {
            "anyOf": [
              {
                "maxLength": 40,
                "pattern": "^\\d+(?:\\.\\d{1,10})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Price"
          },
          "security_id": {
            "format": "uuid",
            "title": "Security Id",
            "type": "string"
          }
        },
        "required": [
          "security_id",
          "quantity",
          "currency"
        ],
        "title": "PositionInput",
        "type": "object"
      },
      "PositionLineRead": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "price_as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price As Of"
          },
          "quality_status": {
            "title": "Quality Status",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "reported_price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Price"
          },
          "reported_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Value"
          },
          "security": {
            "$ref": "#/components/schemas/SecurityRead"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "security",
          "quantity",
          "reported_price",
          "reported_value",
          "currency",
          "price_as_of",
          "source",
          "quality_status"
        ],
        "title": "PositionLineRead",
        "type": "object"
      },
      "PositionReplace": {
        "properties": {
          "effective_date": {
            "format": "date",
            "title": "Effective Date",
            "type": "string"
          },
          "expected_revision": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionInput"
            },
            "maxItems": 500,
            "title": "Positions",
            "type": "array"
          }
        },
        "required": [
          "expected_revision",
          "effective_date",
          "positions"
        ],
        "title": "PositionReplace",
        "type": "object"
      },
      "PositionSnapshotRead": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "effective_date": {
            "format": "date",
            "title": "Effective Date",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionLineRead"
            },
            "title": "Positions",
            "type": "array"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "account_id",
          "effective_date",
          "revision",
          "source",
          "positions"
        ],
        "title": "PositionSnapshotRead",
        "type": "object"
      },
      "PositionsEnvelope": {
        "properties": {
          "snapshot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PositionSnapshotRead"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "snapshot"
        ],
        "title": "PositionsEnvelope",
        "type": "object"
      },
      "SecurityRead": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "display_ticker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Ticker"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "security_type": {
            "title": "Security Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "security_type",
          "display_ticker",
          "name",
          "currency"
        ],
        "title": "SecurityRead",
        "type": "object"
      },
      "SecurityResolution": {
        "properties": {
          "matches": {
            "items": {
              "$ref": "#/components/schemas/SecurityRead"
            },
            "title": "Matches",
            "type": "array"
          },
          "status": {
            "enum": [
              "resolved",
              "ambiguous",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "matches"
        ],
        "title": "SecurityResolution",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
