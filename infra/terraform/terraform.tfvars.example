# Copy into an ignored local tfvars file and fill actual target identifiers.
# No secret payloads. Bootstrap with enable_runtime=false.
project_id             = "your-project-id"
private_bucket         = "your-globally-unique-private-bucket"
hosting_site           = "your-hosting-site"
public_origin          = "https://your-hosting-site.web.app"
auth_issuer_url        = "https://your-oidc-issuer"
auth_client_id         = "your-client-id"
auth_allowed_subject   = "your-owner-subject"
auth_personal_scope_id = "your-finance-scope"
enable_runtime         = false
